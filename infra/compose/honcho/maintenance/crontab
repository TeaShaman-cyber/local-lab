SHELL=/bin/sh
PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# supercronic (not Debian cron) runs this file, and it inherits the container
# environment. That is why PG* and HONCHO_API are not repeated here: Debian cron
# would have required copying them, because it builds a separate jobenv.
#
# --apply is used on a schedule on purpose: a dry-run cron job would produce
# reports nobody reads. What makes it safe unattended is the guard inside the
# script (--max-delete-pct aborts a run that would remove too much) plus soft
# deletes through the API, which the reconciler later prunes.
#
# A clean run prints "nothing to do"; that line in `docker logs` is the signal
# that the bank still holds and no duplication regrew overnight.
#
# No redirection to a file: supercronic runs with -passthrough-logs, so output
# belongs in the container log. A file inside the image would not be rotated,
# would grow unbounded and would vanish with the container, taking the failure
# details with it.
15 4 * * * python /app/dedup.py --apply --json /var/log/honcho/last.json
