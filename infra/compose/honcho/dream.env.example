# Dream-модель через BotHub.
#
# Значения ключа здесь нет намеренно: ключ живёт в окружении (.env профиля),
# в репозиторий попадают только имена переменных.
#
# Грабля: base_url и api_key живут ВНУТРИ overrides. Верхнеуровневые
# DREAM__*_MODEL_CONFIG__BASE_URL / __API_KEY принимаются молча и не применяются.

DREAM__DEDUCTION_MODEL_CONFIG__MODEL=mistral-small-3.2-24b-instruct
DREAM__DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openai.bothub.chat/v1
DREAM__DEDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY=

DREAM__INDUCTION_MODEL_CONFIG__MODEL=mistral-small-3.2-24b-instruct
DREAM__INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openai.bothub.chat/v1
DREAM__INDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY=

# Сколько итераций dream может потратить на запись, прежде чем закончить.
DREAM__WRITE_WINDOW_ITERATIONS=5

# Fallback для dream-моделей: другая модель и ДРУГОЕ семейство, чем primary.
# Смысл: если BotHub откажет по mistral, лимит/сбой не должен сваливать обе модели.
# gemini-2.5-flash проверен на двухшаговом контракте search_memory -> create_observations:
#   чисто, 12.9s (gpt-5-mini 29.7s, claude-haiku-4.5 дублировал поиск).
DREAM__DEDUCTION_MODEL_CONFIG__FALLBACK__MODEL=gemini-2.5-flash
DREAM__DEDUCTION_MODEL_CONFIG__FALLBACK__TRANSPORT=openai
DREAM__DEDUCTION_MODEL_CONFIG__FALLBACK__OVERRIDES__BASE_URL=https://openai.bothub.chat/v1
DREAM__DEDUCTION_MODEL_CONFIG__FALLBACK__OVERRIDES__API_KEY=

DREAM__INDUCTION_MODEL_CONFIG__FALLBACK__MODEL=gemini-2.5-flash
DREAM__INDUCTION_MODEL_CONFIG__FALLBACK__TRANSPORT=openai
DREAM__INDUCTION_MODEL_CONFIG__FALLBACK__OVERRIDES__BASE_URL=https://openai.bothub.chat/v1
DREAM__INDUCTION_MODEL_CONFIG__FALLBACK__OVERRIDES__API_KEY=
