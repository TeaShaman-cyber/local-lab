    },
    "name": "ag2bozoipq5moe",
    "namespace": "stacks-1891821"
  },
  "spec": {
    "annotations": {
      "description": "Реренк cross-encoder на eval-стенде деградировал: p95 {{ $value }} с при пороге 15 с. NoData здесь не считается инцидентом: eval-стенд бывает выключен, и отсутствие метрик — норма. Настроено 2026-10-30, потому что DatasourceNoData по этому правилу шумел каждые несколько часов и маскировал настоящие алерты.",
      "summary": "Hindsight eval: реранк p95 превысил 15 с"
    },
    "execErrState": "Ok",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hindsight_recall_phase_duration_seconds_bucket{job=\"hindsight-eval\", phase=\"reranking\"}[5m])))",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "10m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  15
                ],
                "type": "gt"
              }
            }
          ],
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m0s",
    "labels": {
      "component": "hindsight",
      "env": "eval",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "notificationSettings": {
      "receiver": "theseus-email",
      "type": "SimplifiedRouting"
    },
    "title": "Hindsight eval: реранк p95 \u003e 15 с",
    "trigger": {
      "interval": "1m"
    }
  }
}
