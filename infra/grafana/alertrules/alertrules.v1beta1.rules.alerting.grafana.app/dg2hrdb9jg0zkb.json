  "spec": {
    "annotations": {
      "description": "Restore-проверка не прошла: либо restore не дал файла, либо sha256 не совпал. Это значит, что архив существует, но восстановить его нельзя — самый опасный класс отказа. Проверить целостность репозитория через restic check --read-data.",
      "summary": "Проверка восстановлением провалена"
    },
    "execErrState": "Ok",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-logs",
        "model": {
          "expr": "sum(count_over_time({job=\"backup\"} |= \"event=BACKUP_DRILL\" |= \"status=fail\" [2h]))",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "10m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "labels": {
      "area": "backup",
      "severity": "critical"
    },
    "noDataState": "Ok",
    "notificationSettings": {
      "receiver": "theseus-email",
      "type": "SimplifiedRouting"
    },
    "title": "Backup: восстановление не прошло",
    "trigger": {
      "interval": "1m"
    }
  }
