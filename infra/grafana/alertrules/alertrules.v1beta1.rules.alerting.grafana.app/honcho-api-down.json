{
  "apiVersion": "rules.alerting.grafana.app/v1beta1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "ag2b9ny7raxogc",
      "grafana.com/provenance": "api",
      "grafana.com/updateTimestamp": "2026-11-08T08:34:38Z",
      "grafana.com/updatedBy": "cg2aw002vdqtca"
    },
    "labels": {
      "grafana.app/folder": "ag2b9ny7raxogc"
    },
    "name": "honcho-api-down",
    "namespace": "stacks-1891821"
  },
  "spec": {
    "annotations": {
      "description": "Alloy жив, а scrape-цель honcho-api недоступна: `max(up{job=\"honcho-api\"})` = 0.\n\nЧто это значит практически: Hermes продолжает работать, но recall и запись памяти идут в мёртвый сервис. Чат выглядит нормальным — «не помню» вместо ошибки, поэтому без правила это не заметить.\n\nПочему noDataState = Ok: когда ноутбук выключен, Alloy не отправляет ничего, ряд `up` устаревает и правило уходит в no-data. Это «не знаю», а не инцидент; будить по выключенному ноутбуку нельзя. Поэтому же в условии нет Alloy-гарда: пропавший `up` здесь сам означает тишину, а не отказ.\n\nГраница: если цель уберут из конфигурации Alloy совсем, правило будет молчать — «цель исчезла» это отдельный класс и сюда не входит.",
      "runbook_url": "https://github.com/TeaShaman-cyber/local-lab/issues/209",
      "summary": "Honcho API недоступен: up{job=\"honcho-api\"} = 0"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "expr": "max(up{job=\"honcho-api\"})",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "5m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "lt"
              }
            }
          ],
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m0s",
    "labels": {
      "area": "availability",
      "component": "honcho",
      "severity": "critical"
    },
    "noDataState": "Ok",
    "notificationSettings": {
      "receiver": "theseus-email",
      "type": "SimplifiedRouting"
    },
    "title": "Honcho API недоступен",
    "trigger": {
      "interval": "1m"
    }
  }
}
