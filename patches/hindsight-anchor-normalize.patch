+_GITHUB_REF = re.compile(r"(?<![\w./&-])#(\d{1,6})\b")
+_REMOTE_RE = re.compile(r"(?:^|[@/])github\.com(?::\d+)?[:/]([^/]+)/([^/\s]+?)(?:\.git)?/?$")
+_REPO_SLUG_CACHE: dict[str, tuple[float, str | None]] = {}
+
+
+def _current_repo_slug() -> str | None:
+    """owner/repo of the git remote in the current working directory, or None."""
+    cwd = os.getcwd()
+    now = time.time()
+    cached = _REPO_SLUG_CACHE.get(cwd)
+    if cached and now - cached[0] < 300:
+        return cached[1]
+    slug = None
+    try:
+        out = subprocess.run(
+            ["git", "-C", cwd, "remote", "get-url", "origin"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+        url = (out.stdout or "").strip()
+        match = _REMOTE_RE.search(url)
+        if match:
+            slug = f"{match.group(1)}/{match.group(2)}"
+    except Exception:
+        slug = None
+    _REPO_SLUG_CACHE[cwd] = (now, slug)
+    return slug
+
+
+def _normalize_github_refs(text: str) -> str:
+    """Rewrite a bare #NNN to owner/repo#NNN using the current git remote.
+
+    Deterministic by design: the extraction model should not have to infer which
+    repository a number belongs to. Numbers that already carry owner/repo are left
+    untouched, and nothing changes when the remote cannot be resolved.
+    """
+    if not isinstance(text, str) or "#" not in text:
+        return text
+    slug = _current_repo_slug()
+    if not slug:
+        return text
+    return _GITHUB_REF.sub(lambda m: f"{slug}#{m.group(1)}", text)
+
+
