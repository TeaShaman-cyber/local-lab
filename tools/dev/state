#!/usr/bin/env bash
# Thin compatibility wrapper. The real script is state.py; this keeps existing
# `tools/dev/state` calls working. See issue #170.
here="$(cd "$(dirname "$0")" && pwd)"
target="$here/state.py"
command -v cygpath >/dev/null 2>&1 && target="$(cygpath -m "$target")"
exec "$target" "$@"
