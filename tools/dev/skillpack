#!/usr/bin/env python3
"""Report whether the installed matt-pocock skill copy matches its upstream.

Three questions, and they must be asked separately:

1. Which version is installed, and which is upstream?
2. Did **upstream** change a skill we have installed?      -> stale, worth updating
3. Did **we** edit a skill locally?                        -> deviation, not staleness

A one-sided hash comparison conflates 2 and 3. It reported "we removed the
fresh-context requirement" when 1.3.2 had just added that requirement upstream
— the exact wrong conclusion, drawn from a correct hash difference.

So the comparison is three-way, against the base commit the copy was taken
from. ``BASE_COMMIT`` changes only when the copy is refreshed, and the refresh
is what updates ``docs/agents/deviations.md``.

Exit codes: 0 = copy matches its base and no upstream drift, 1 = drift found,
2 = cannot compare (clone or metadata missing).

Usage::

    python tools/dev/skillpack                 # human-readable report
    python tools/dev/skillpack --json
    python tools/dev/skillpack --self-test
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import subprocess
import sys

#: Commit the installed copy was taken from (version 1.3.1).
BASE_COMMIT = "5beb35b"
#: Human-readable version of that commit.
BASE_VERSION = "1.3.1"
#: Package identity upstream.
UPSTREAM = "mattpocock/skills"

INSTALLED = pathlib.Path(os.environ.get("LOCALAPPDATA", "")) / "hermes" / "skills" / "matt-pocock"
CLONES = [pathlib.Path("E:/matt-upstream")]


def find_clone() -> pathlib.Path | None:
    for candidate in CLONES:
        if (candidate / ".git").is_dir():
            return candidate
    return None


def digest_all(root: pathlib.Path) -> tuple[str, int]:
    """Hash every file with its name, so a renamed file changes the result."""
    hasher = hashlib.sha256()
    files = sorted(p for p in root.rglob("*") if p.is_file())
    for path in files:
        hasher.update(path.relative_to(root).as_posix().encode())
        hasher.update(b"\0")
        hasher.update(path.read_bytes())
    return hasher.hexdigest(), len(files)


def digest_skill_md(root: pathlib.Path) -> tuple[str, int]:
    hasher = hashlib.sha256()
    files = sorted(root.rglob("SKILL.md"))
    for path in files:
        hasher.update(path.read_bytes())
    return hasher.hexdigest(), len(files)


def skill_names(root: pathlib.Path, nested: bool) -> set[str]:
    if nested:
        return {p.parent.name for p in root.rglob("SKILL.md")}
    return {p.name for p in root.iterdir() if (p / "SKILL.md").is_file()}


def upstream_version(clone: pathlib.Path) -> str | None:
    try:
        raw = subprocess.run(
            ["git", "show", "origin/main:package.json"],
            cwd=clone, capture_output=True, text=True, check=True,
        ).stdout
        return json.loads(raw).get("version")
    except (subprocess.CalledProcessError, json.JSONDecodeError, OSError):
        return None


def _blob_sha(clone: pathlib.Path, ref: str, path: str) -> str | None:
    try:
        data = subprocess.run(
            ["git", "show", f"{ref}:{path}"],
            cwd=clone, capture_output=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, OSError):
        return None
    return hashlib.sha256(data).hexdigest()[:12]


def _skill_paths(clone: pathlib.Path, ref: str, name: str) -> list[str]:
    try:
        listing = subprocess.run(
            ["git", "ls-tree", "-r", "--name-only", ref, "--", "skills"],
            cwd=clone, capture_output=True, text=True, check=True,
        ).stdout.splitlines()
    except (subprocess.CalledProcessError, OSError):
        return []
    return [p for p in listing if pathlib.PurePosixPath(p).parent.name == name and pathlib.PurePosixPath(p).name == "SKILL.md"]


def classify_verdict(installed: str, base: str, head: str) -> str:
    """Decide who moved, given three hashes. The one place this decision lives."""
    if installed == base and base == head:
        return "unchanged"
    if installed == base and base != head:
        return "stale"
    if installed != base and base == head:
        return "our-edit"
    if installed == head:
        return "up-to-date"
    return "conflict"


def three_way(clone: pathlib.Path, names: set[str]) -> dict[str, str]:
    """Classify each installed skill: unmoved, stale, ours, or conflicted."""
    verdicts: dict[str, str] = {}
    for name in sorted(names):
        paths = _skill_paths(clone, BASE_COMMIT, name)
        if not paths:
            verdicts[name] = "not-in-base"
            continue
        path = paths[0]
        inst_file = INSTALLED / name / "SKILL.md"
        if not inst_file.is_file():
            verdicts[name] = "missing-locally"
            continue
        inst = hashlib.sha256(inst_file.read_bytes()).hexdigest()[:12]
        old = _blob_sha(clone, BASE_COMMIT, path)
        new = _blob_sha(clone, "origin/main", path)
        if old is None or new is None:
            verdicts[name] = "unreadable"
        else:
            verdicts[name] = classify_verdict(inst, old, new)
    return verdicts


def self_test() -> tuple[bool, str]:
    """Fixed inputs and outputs for the classifier.

    This must call ``classify_verdict`` rather than re-implement it: a test that
    copies the logic passes while the function it is supposed to guard is
    broken.
    """
    cases = [
        # (installed, base, head, want)
        ("aaa", "aaa", "aaa", "unchanged"),
        ("aaa", "aaa", "bbb", "stale"),
        ("bbb", "aaa", "aaa", "our-edit"),
        ("bbb", "aaa", "bbb", "up-to-date"),
        ("ccc", "aaa", "bbb", "conflict"),
        ("aaa", "bbb", "aaa", "up-to-date"),  # we are the old side, upstream is base
    ]
    failures = []
    for inst, old, new, want in cases:
        got = classify_verdict(inst, old, new)
        if got != want:
            failures.append(f"{inst}/{old}/{new}: want {want} got {got}")
    if failures:
        return False, "; ".join(failures)
    return True, f"{len(cases)} cases, all match"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()

    if args.self_test:
        ok, detail = self_test()
        print(detail, file=sys.stdout if ok else sys.stderr)
        return 0 if ok else 1

    if not INSTALLED.is_dir():
        print(f"installed copy not found: {INSTALLED}", file=sys.stderr)
        return 2

    full_sha, full_count = digest_all(INSTALLED)
    md_sha, md_count = digest_skill_md(INSTALLED)
    names = skill_names(INSTALLED, nested=False)

    clone = find_clone()
    if clone is None:
        print(f"upstream clone not found in {[str(c) for c in CLONES]}; cannot compare", file=sys.stderr)
        return 2

    version = upstream_version(clone)
    verdicts = three_way(clone, names)
    counts: dict[str, int] = {}
    for verdict in verdicts.values():
        counts[verdict] = counts.get(verdict, 0) + 1

    stale = sorted(n for n, v in verdicts.items() if v == "stale")
    ours = sorted(n for n, v in verdicts.items() if v == "our-edit")
    conflicts = sorted(n for n, v in verdicts.items() if v == "conflict")

    report = {
        "upstream": UPSTREAM,
        "installed_version": BASE_VERSION,
        "installed_base_commit": BASE_COMMIT,
        "upstream_version": version,
        "skills_installed": len(names),
        "files_total": full_count,
        "sha256_all": full_sha,
        "sha256_skill_md": md_sha,
        "verdict_counts": counts,
        "stale": stale,
        "our_edits": ours,
        "conflicts": conflicts,
    }

    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    else:
        print(f"installed {BASE_VERSION} ({BASE_COMMIT}), upstream {version}")
        print(f"skills {len(names)}, files {full_count}")
        print(f"all {full_sha[:16]}  skill.md {md_sha[:16]}")
        if stale:
            print(f"STALE ({len(stale)}): {', '.join(stale)}")
        if ours:
            print(f"OUR EDITS ({len(ours)}): {', '.join(ours)} — must appear in docs/agents/deviations.md")
        if conflicts:
            print(f"CONFLICTS ({len(conflicts)}): {', '.join(conflicts)} — both sides edited, resolve by hand")
        if not stale and not conflicts:
            print("no upstream drift for installed skills")

    return 1 if (stale or conflicts) else 0


if __name__ == "__main__":
    raise SystemExit(main())
