#!/usr/bin/env bash
# Thin compatibility wrapper. The real script is check.sh, named so that
# static parsers see its language; this keeps every existing `tools/dev/check`
# call working. See issue #170.
here="$(cd "$(dirname "$0")" && pwd)"
target="$here/check.sh"
# On MSYS, hand native programs a native path; elsewhere this is a no-op.
command -v cygpath >/dev/null 2>&1 && target="$(cygpath -m "$target")"
exec "$target" "$@"
