#!/usr/bin/env bash
# Repository-owned canonical QA endpoint.
#
# The workflow stays dumb: it checks out the PR head and runs this script.
# All checks live here, so they can be run locally with the same result —
# `tools/dev/check` is the gate, CI is only where it executes.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

echo "=== infra contract ==="
python tools/contracts/check_infra.py

echo "=== infra self-test ==="
python tools/contracts/check_infra.py --self-test

echo "=== python syntax ==="
while IFS= read -r -d '' f; do
    python -m py_compile "$f"
done < <(find tools scripts -name "*.py" -print0 2>/dev/null)
echo "ok"

echo "=== yaml syntax ==="
python - <<'PY'
import pathlib, sys, yaml
bad = 0
for p in list(pathlib.Path(".").rglob("*.yml")) + list(pathlib.Path(".").rglob("*.yaml")):
    if ".git" in p.parts:
        continue
    try:
        yaml.safe_load(p.read_text(encoding="utf-8"))
        print(f"ok  {p}")
    except Exception as exc:
        print(f"FAIL {p}: {exc}", file=sys.stderr)
        bad = 1
sys.exit(bad)
PY

# Linters, not just parsers. A parser proves the file loads; a linter knows the
# idioms that bite. ShellCheck alone caught `rm -rf "$DEST/$name"` expanding to
# `rm -rf "/$name"` when a variable goes empty — the author, an independent
# reviewer and Codex all read past it.
#
# STRICT=1 turns a missing tool into a failure; CI sets it so the gate cannot go
# quiet. Locally the tools may be absent, and then the check says SKIP out loud
# instead of pretending it verified something.
STRICT="${STRICT:-0}"
lint_fail=0

find_tool() {
    local name="$1"
    if command -v "$name" >/dev/null 2>&1; then command -v "$name"; return 0; fi
    # Tools installed by `uv tool install` land here, outside the Hermes venv, so
    # they survive a Hermes update — which is the point of not using `python -m`.
    for p in "$HOME/.local/bin/$name.exe" "E:/tools/$name/$name.exe"; do
        if [ -x "$p" ]; then echo "$p"; return 0; fi
    done
    return 1
}

echo "=== shellcheck ==="
if sc="$(find_tool shellcheck)"; then
    bad=0
    for f in scripts/*.sh .githooks/*; do
        [ -f "$f" ] || continue
        if ! "$sc" -S warning "$f"; then
            echo "FAIL shellcheck: $f" >&2
            bad=1
        fi
    done
    if [ "$bad" -eq 0 ]; then echo "ok"; else lint_fail=1; fi
else
    if [ "$STRICT" -eq 1 ]; then echo "FAIL shellcheck not installed (STRICT=1)" >&2; lint_fail=1; else echo "SKIP shellcheck not installed"; fi
fi

echo "=== actionlint ==="
if al="$(find_tool actionlint)"; then
    if ! "$al" .github/workflows/*.yml; then
        echo "FAIL actionlint" >&2
        lint_fail=1
    fi
else
    if [ "$STRICT" -eq 1 ]; then echo "FAIL actionlint not installed (STRICT=1)" >&2; lint_fail=1; else echo "SKIP actionlint not installed"; fi
fi

echo "=== ruff ==="
if ruf="$(find_tool ruff)"; then
    if ! "$ruf" check tools scripts --quiet; then
        echo "FAIL ruff" >&2
        lint_fail=1
    fi
else
    if [ "$STRICT" -eq 1 ]; then echo "FAIL ruff not installed (STRICT=1)" >&2; lint_fail=1; else echo "SKIP ruff not installed"; fi
fi

echo "=== yamllint ==="
if yl="$(find_tool yamllint)"; then
    if ! "$yl" .github/workflows docs/reference infra 2>/dev/null; then
        echo "FAIL yamllint" >&2
        lint_fail=1
    fi
else
    if [ "$STRICT" -eq 1 ]; then echo "FAIL yamllint not installed (STRICT=1)" >&2; lint_fail=1; else echo "SKIP yamllint not installed"; fi
fi

echo "=== shell syntax ==="
for f in scripts/*.sh .githooks/*; do
    [ -f "$f" ] || continue
    bash -n "$f"
    echo "ok  $f"
done

if [ "$lint_fail" -ne 0 ]; then
    echo "QA FAIL: linters found problems (see above)" >&2
    exit 1
fi

echo "=== secrets scan ==="
if grep -rnE 'glc_[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|BEGIN [A-Z ]*PRIVATE KEY' \
    --include="*.py" --include="*.yaml" --include="*.yml" --include="*.sh" \
    --exclude-dir=.git . ; then
    echo "FAIL: secret-like token found" >&2
    exit 1
fi
echo "ok"

echo "=== QA PASS ==="
