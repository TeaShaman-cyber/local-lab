+def _repo_named_in_text(text: str) -> str | None:
+    """owner/repo written out in the entry, or None.
+
+    Used only when the session cwd is unavailable (upstream #144869): Desktop and
+    gateway sessions hand providers no cwd, so the git remote cannot be resolved
+    and normalisation used to switch itself off silently. Reading the repository
+    from the entry is narrower than os.getcwd(), which is one process-wide
+    directory shared by every session in the gateway, and it never invents a
+    repository the text does not name.
+    """
+    for match in _NAMED_REPO.finditer(text):
+        before = text[max(0, match.start() - 80) : match.start()].lower()
+        if _ISSUE_CONTEXT.search(before) or "репозитор" in before or "repo" in before:
+            return f"{match.group(1)}/{match.group(2)}"
+    return None
+
